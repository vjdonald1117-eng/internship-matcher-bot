# Discord Alert Configuration
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"

# Matching Threshold (0.0 to 1.0) - Note: MiniLM cosine similarity for strong document matches typically ranges 0.55 - 0.80
SIMILARITY_THRESHOLD=0.75

# Search Parameters (Comma-separated)
SEARCH_KEYWORDS="Software Engineer Intern,Backend Engineer Intern,Machine Learning Intern"
SEARCH_LOCATIONS="Remote,United States"
MAX_JOBS_PER_PLATFORM=15

# Handshake University Domain (e.g., https://app.joinhandshake.com)
HANDSHAKE_BASE_URL="https://app.joinhandshake.com"